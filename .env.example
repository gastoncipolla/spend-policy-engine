# Optional. Without it, Covered runs in mock mode with the sample policies.
ANTHROPIC_API_KEY=

# mock | anthropic (default: anthropic if ANTHROPIC_API_KEY is set, else mock)
COVERED_PROVIDER=

# Model used to compile policies (default claude-haiku-5-5; claude-sonnet-5-5 is the fallback)
COVERED_MODEL=claude-haiku-5-5

# SQLite file
COVERED_DB=./data/covered.db

# Model used by "Ask Covered" to read expense sentences (default claude-haiku-5-5)
COVERED_INTAKE_MODEL=
